# Supabase project URL
SUPABASE_URL=

# SERVER ONLY. NEVER put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origin(s), comma-separated if needed.
FRONTEND_URL=http://localhost:3000

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Check-in only works while the library is open (Jamaica time).
# Set ENFORCE_OPENING_HOURS=false to test or demo outside these hours.
ENFORCE_OPENING_HOURS=true
LIBRARY_OPEN_TIME=08:30
LIBRARY_CLOSE_TIME=18:00
